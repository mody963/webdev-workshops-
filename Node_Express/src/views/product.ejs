<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
</head>
<body>
    <a href="/products">← Back to all products</a>
    
    <% if (product) { %>
        <div style="border: 1px solid black; padding: 1rem; margin-top: 1rem; max-width: 400px;">
            <h1><%= product.name %></h1>

            <!-- Category Display -->
            <p>
              <strong>Category:</strong> 
              <%= product.category ? product.category.name : 'Uncategorized' %>
            </p>

            <p><strong>Description:</strong> <%= product.description %></p>
            <p><strong>Price:</strong> $<%= product.price %></p>
            <p><small>Product ID: <%= product.id %></small></p>
            
            <hr>
            <a href="/product/delete/<%= product.id %>" style="color: red;">Delete Product</a>
        </div>
    <% } else { %>
        <h1>Product Not Found</h1>
        <p>The product you are looking for does not exist.</p>
    <% } %>
</body>
</html>
